{
  "expo": {
    "name": "NeuroAI",
    "slug": "neuroai-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#050714"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neuroai.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "NeuroAI needs microphone access for speech analysis."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#050714"
      },
      "package": "com.neuroai.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "NeuroAI needs microphone access for speech analysis."
        }
      ]
    ]
  }
}
